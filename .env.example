# ============================================================
# SmartSupport AI —— 环境变量清单
#
# 用法：复制本文件为 .env，按需填入真实值后再启动服务。
#   cp .env.example .env      # Linux / macOS
#   copy .env.example .env    # Windows CMD
#
# .env 已被 .gitignore 排除，绝不会被提交到版本库。
# 本文件只放变量名与占位符，禁止写入任何真实密钥或密码。
# ============================================================

# ---- DeepSeek 聊天模型（必填）----
# 用于 /ai/chat、/ai/knowledge/chat 的流式对话与工具调用
# 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK-KEY=your-deepseek-api-key-here

# ---- 阿里云百炼 Embedding 模型（必填）----
# 用于 text-embedding-v4，把知识库文档转成 1024 维向量
# 获取地址：https://bailian.console.aliyun.com/
ALIYUN-KEY=your-aliyun-bailian-api-key-here

# ---- MySQL 业务库（必填）----
# 对应 application.yml 的 spring.datasource.password
# 需与本机 MySQL 的 root 密码一致
MYSQL_PASSWORD=your-mysql-root-password-here

# ---- PostgreSQL 向量库（必填）----
# 对应 application.yml 的 pgvector.datasource.password，
# 也对应 backend/docker-compose.yml 的 POSTGRES_PASSWORD（两者必须一致）
PG_PASSWORD=your-postgres-password-here
